# Copy this file to ".env" in this same folder and fill in real values.
# ".env" is gitignored at the repo root - this file (no leading dot) is the
# one that's safe to commit as a template.

# From cPanel -> MySQL Database Wizard. DB_HOST is almost always "localhost"
# when this server runs on the same cPanel account as the database (the
# normal case here). DB_NAME and DB_USER are cPanel-prefixed, e.g.
# "fjvwkkmge_bgo_data" and "fjvwkkmge_bgo_app" - use the full prefixed names.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_PREFIXED_DB_NAME
DB_USER=REPLACE_WITH_PREFIXED_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Must match the projectId in src/lib/firebase.js. Used to verify who is
# calling this server (needs no secret, only the public project id) - every
# request must come from a signed-in Firebase user.
FIREBASE_PROJECT_ID=njiru-carwash

# This server's own port, and which frontend origin may call it.
# In production (cPanel), Passenger assigns the port itself regardless of
# this value, and CORS_ORIGIN should be the real site, e.g.
# https://bgoshinehub.co.ke
PORT=4051
CORS_ORIGIN=http://localhost:5183

# Leave this "false" (or unset) for your real business's database - a fresh
# database then stays genuinely empty, ready for you to set up your actual
# business through the app itself. Only set to "true" for a throwaway
# QA/staging database where you actually want the demo Njiru/Kayole/Utawala
# dataset. Either way this only ever seeds once - it's a no-op the moment
# the database already has any businesses in it.
SEED_DEMO_DATA=false

# Optional - powers "Scan Vehicle Photo" on the check-in form (auto-fills
# plate/make/model/color from a photo instead of typing them in). Leave
# unset to keep that button hidden; the rest of the app works fine without
# it. Get a key from https://platform.openai.com/api-keys - this is a paid
# API, billed per scan, and must never be shared with the browser (that's
# why this lives here, not in the root .env). OPENAI_VISION_MODEL defaults
# to "gpt-4o-mini" if unset.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
