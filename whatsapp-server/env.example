# Copy this file to ".env" in this same folder and fill in real values as you
# get them. ".env" is gitignored at the repo root — this file (no leading
# dot) is the one that's safe to commit as a template.
#
# This server now runs THREE things in one process (merged to save cPanel
# Node.js App slots / processes - see README.md "Why one process"):
#   - WhatsApp notifications (Meta Cloud API)     -> /api/whatsapp/*
#   - Staff login admin (Firebase Admin SDK)      -> /api/users/*
#   - Shared app data store (MySQL)               -> /api/data, /api/vision, /api/public

# ── WhatsApp ─────────────────────────────────────────────────────────────
# mock — no calls to Meta at all; a "send" just logs and immediately reports
#        success, so the full trigger -> notification-record flow works right
#        now with zero setup.
# live — real calls to the WhatsApp Cloud API (graph.facebook.com).
WHATSAPP_ENV=mock

# From a Meta app at https://developers.facebook.com with the WhatsApp
# product added. The access token is a permanent System User token generated
# once you attach a real WhatsApp Business Account - the short-lived token
# Meta gives you by default expires in 24h and isn't meant for a running server.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_BUSINESS_ACCOUNT_ID

# A value you make up yourself — enter the SAME value in Meta's App Dashboard
# under WhatsApp > Configuration > Webhook when you set the callback URL, so
# Meta's verification handshake (GET with hub.verify_token) matches this.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_STRING_YOU_PICK

# ── Staff login admin (Firebase Admin SDK) ──────────────────────────────
# Creating a user, resetting a password, or assigning a branch/role all call
# privileged Firebase Admin Auth actions that need a real service account —
# there is no "mock mode" for these specifically, because the accounts they
# create must be real Firebase Auth accounts for that person to actually log
# in through the app (which always talks to the real Firebase project).
#
# Get one: Firebase Console -> Project settings (gear icon) -> Service
# accounts tab -> "Generate new private key". Open the downloaded JSON file
# and paste its ENTIRE contents as one single line here.
#
# On some hosting control panels (cPanel/CloudLinux's Node.js Selector
# included), pasting the raw JSON into their env-var UI silently strips
# quotes/newlines from the private key, breaking it. If that happens, set
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 instead - base64-encode the same JSON
# first (e.g. locally: `node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"`
# or in PowerShell: `[Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))`)
# and paste that single unbroken string as the value. It's tried first if set.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Must match the projectId in src/lib/firebase.js. Used to verify sign-in
# tokens (who is calling this server) even before a service account is set —
# that part needs no secret, only the public project id. Shared by both the
# staff-login admin routes and the app-data routes below.
FIREBASE_PROJECT_ID=njiru-carwash

# Username-only accounts (created by a manager/owner/super admin) get a fake
# email under this domain behind the scenes, since Firebase Auth's
# email/password provider requires an email-shaped identifier. Nobody sends
# mail here — it's never dereferenced.
SYNTHETIC_EMAIL_DOMAIN=users.bgoshinehub.internal

# Same idea for accounts created with a phone number instead of a username —
# a separate domain so the two namespaces can never collide.
SYNTHETIC_PHONE_DOMAIN=phone.bgoshinehub.internal

# Base URL of THIS server's own /api/data routes. Creating or assigning a
# business-scoped login needs to add that person to the business's own
# member list too, via a plain HTTP call to itself - in production this is
# https://whatsapp.bgoshinehub.co.ke (the same host this file's app runs on).
APP_DATA_API_URL=http://localhost:4031

# ── Shared app data store (MySQL) ───────────────────────────────────────
# From cPanel -> MySQL Database Wizard. DB_HOST is almost always "localhost"
# when this server runs on the same cPanel account as the database (the
# normal case here). DB_NAME and DB_USER are cPanel-prefixed, e.g.
# "fjvwkkmge_bgo_data" and "fjvwkkmge_bgo_app" - use the full prefixed names.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_PREFIXED_DB_NAME
DB_USER=REPLACE_WITH_PREFIXED_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Leave this "false" (or unset) for your real business's database - a fresh
# database then stays genuinely empty, ready for you to set up your actual
# business through the app itself. Only set to "true" for a throwaway
# QA/staging database where you actually want the demo Njiru/Kayole/Utawala
# dataset. Either way this only ever seeds once - it's a no-op the moment
# the database already has any businesses in it.
SEED_DEMO_DATA=false

# Optional - powers "Scan Vehicle Photo" on the check-in form (auto-fills
# plate/make/model/color from a photo instead of typing them in). Leave
# unset to keep that button hidden; the rest of the app works fine without
# it. Get a key from https://platform.openai.com/api-keys - this is a paid
# API, billed per scan, and must never be shared with the browser (that's
# why this lives here, not in the root .env). OPENAI_VISION_MODEL defaults
# to "gpt-4o-mini" if unset.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Shared by all three ──────────────────────────────────────────────────
# This server's own port, and which frontend origin may call it.
# In production (cPanel), Passenger assigns the port itself regardless of
# this value, and CORS_ORIGIN should be the real site, e.g.
# https://bgoshinehub.co.ke — the webhook URL Meta calls also then becomes
# this server's own real public URL (e.g. https://whatsapp.bgoshinehub.co.ke/api/whatsapp/webhook).
PORT=4031
CORS_ORIGIN=http://localhost:5183
