# Copy this file to ".env" in this same folder and fill in real values as you
# get them. ".env" is gitignored at the repo root — this file (no leading
# dot) is the one that's safe to commit as a template.

# mock — no calls to Meta at all; a "send" just logs and immediately reports
#        success, so the full trigger -> notification-record flow works right
#        now with zero setup.
# live — real calls to the WhatsApp Cloud API (graph.facebook.com).
WHATSAPP_ENV=mock

# From a Meta app at https://developers.facebook.com with the WhatsApp
# product added. The access token is a permanent System User token generated
# once you attach a real WhatsApp Business Account — the short-lived token
# Meta gives you by default expires in 24h and isn't meant for a running server.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_BUSINESS_ACCOUNT_ID

# A value you make up yourself — enter the SAME value in Meta's App Dashboard
# under WhatsApp > Configuration > Webhook when you set the callback URL, so
# Meta's verification handshake (GET with hub.verify_token) matches this.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_STRING_YOU_PICK

# This server's own port, and which frontend origin may call it.
# In production (cPanel), Passenger assigns the port itself regardless of
# this value, and CORS_ORIGIN should be the real site, e.g.
# https://bgoshinehub.co.ke — the webhook URL Meta calls also then becomes
# this server's own real public URL (e.g. https://whatsapp.bgoshinehub.co.ke/api/whatsapp/webhook).
PORT=4031
CORS_ORIGIN=http://localhost:5183
