# Copy this file to ".env" in this same folder and fill in real values as you
# get them. ".env" is gitignored at the repo root (the ".env.*" rule) — this
# file (no leading dot) is the one that's safe to commit as a template.

# mock      — no Safaricom calls at all; STK pushes "complete" on their own after
#             a few seconds with a fake receipt. Use this until sandbox creds exist.
# sandbox   — real calls to Safaricom's sandbox (https://sandbox.safaricom.co.ke)
# production — real calls to Safaricom's production API (https://api.safaricom.co.ke)
MPESA_ENV=mock

# From the Daraja app you create at https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=REPLACE_WITH_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_CONSUMER_SECRET

# Sandbox default shortcode/passkey (Safaricom's published test values) —
# swap for your own Paybill/Till shortcode + passkey when you go live.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=REPLACE_WITH_PASSKEY

# CustomerPayBillOnline (default, matches the sandbox shortcode above) or
# CustomerBuyGoodsOnline — set to CustomerBuyGoodsOnline once MPESA_SHORTCODE
# is switched to a real Till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Safaricom POSTs the payment result here — it must be a PUBLICLY reachable
# HTTPS URL, so on localhost you need a tunnel (e.g. `ngrok http 4021`) and
# should set this to the tunnel's URL + /api/mpesa/callback. Ignored entirely
# in mock mode.
MPESA_CALLBACK_URL=https://your-public-tunnel-url/api/mpesa/callback

# This server's own port, and which frontend origin may call it.
# In production (cPanel), Passenger assigns the port itself regardless of
# this value, and CORS_ORIGIN should be the real site, e.g.
# https://bgoshinehub.co.ke — this callback URL above then also needs to be
# this server's own real public URL (e.g. https://mpesa.bgoshinehub.co.ke/api/mpesa/callback).
PORT=4021
CORS_ORIGIN=http://localhost:5183
